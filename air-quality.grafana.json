      "targets": [
        {
          "columns": [
            {
              "value": "time"
            },
            {
              "value": "temperature"
            }
          ],
          "datasource": {
            "type": "influxdb",
            "uid": "cftzboqbh3fuoa"
          },
          "format": "table",
          "groupBy": "",
          "limit": "",
          "orderBy": "time",
          "query": "import \"math\"\r\nfrom(bucket: v.defaultBucket)\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"sen55\")\r\n  |> filter(fn: (r) => contains(value: r._field, set: [\"temperature\", \"humidity\"]))\r\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> map(fn: (r) => ({r with f: (r.temperature * 1.8) + 32.0}))\r\n  |> map(fn: (r) => ({r with hi:\r\n      -42.379\r\n      + 2.04901523 * r.f\r\n      + 10.14333127 * r.humidity\r\n      - 0.22475541 * r.f * r.humidity\r\n      - 0.00683783 * r.f * r.f\r\n      - 0.05481717 * r.humidity * r.humidity\r\n      + 0.00122874 * r.f * r.f * r.humidity\r\n      + 0.00085282 * r.f * r.humidity* r.humidity\r\n      - 0.00000199 * r.f * r.f * r.humidity* r.humidity}))\r\n  |> map(fn: (r) => ({r with adjusted:\r\n      r.hi\r\n      + (if r.humidity < 13 and r.f >= 80 and r.f <= 112 then -((13.0 - r.humidity) / 4.0) * math.sqrt(x: 17.0 - math.abs(x: r.f - 95.0) / 17.0) else 0.0)\r\n      + (if r.humidity > 85 and r.f >= 80 and r.f <= 87 then ((r.humidity - 85.0) / 10.0) * ((87.0 - r.f) / 5.0) else 0.0)}))\r\n  |> map(fn: (r) => ({r with simple:\r\n      0.5 * (r.f + 61.0 + ((r.f - 68.0) * 1.2) + (r.humidity * 0.094))}))\r\n  |> map(fn: (r) => ({r with heatindex:\r\n      if r.f <= 40 then r.f else\r\n      if (r.f + r.simple) / 2.0 < 80 then r.simple else r.adjusted}))\r\n  |> map(fn: (r) => ({r with heatindex_c: (r.heatindex - 32.0) / 1.8}))\r\n  |> keep(columns: [\"_time\", \"heatindex_c\"])\r\n",
          "rawEditor": false,
          "refId": "A",
          "table": "sen55",
          "wheres": [
            {
              "value": "$__timeRange(time)"
            }
          ]
        }
      ],
